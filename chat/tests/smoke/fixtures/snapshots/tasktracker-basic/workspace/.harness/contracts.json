      },
      "integration": {
        "scope": "integration",
        "summary": "Wires database, backend, and frontend for local development.",
        "task": "Wire database, backend, frontend. Backend env: DATABASE_HOST=database, DATABASE_PORT=5432, DATABASE_NAME=tasktracker, DATABASE_USER=tasktracker_user, DATABASE_PASSWORD=localdev123. nginx.local.conf proxy /api→backend:3000. depends_on chain: backend depends on database, frontend depends on backend. Healthchecks for each service. Volumes: postgres data persistence.",
        "rules": [
