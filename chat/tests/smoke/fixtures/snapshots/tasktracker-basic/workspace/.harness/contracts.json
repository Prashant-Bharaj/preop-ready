{
  "version": 1,
  "data": {
    "dataModel": {
      "tables": [
        {
          "name": "users",
          "columns": [
            {
              "name": "id",
              "type": "SERIAL PRIMARY KEY"
            },
            {
              "name": "oidc_sub",
              "type": "TEXT UNIQUE NOT NULL"
            },
            {
              "name": "email",
              "type": "VARCHAR(255) NOT NULL"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMP DEFAULT NOW()"
            }
          ]
        },
        {
          "name": "tasks",
          "columns": [
            {
              "name": "id",
              "type": "SERIAL PRIMARY KEY"
            },
            {
              "name": "user_id",
              "type": "INTEGER REFERENCES users(id) NOT NULL"
            },
            {
              "name": "title",
              "type": "VARCHAR(255) NOT NULL"
            },
            {
              "name": "completed",
              "type": "BOOLEAN DEFAULT FALSE"
            },
            {
              "name": "created_at",
              "type": "TIMESTAMP DEFAULT NOW()"
            }
          ]
        }
      ]
    },
    "apiContract": {
      "version": 1,
      "endpoints": [
        {
          "method": "GET",
          "path": "/whoami",
          "response": {
            "status": 200,
            "body": "{ id, email }"
          }
        },
        {
          "method": "GET",
          "path": "/tasks",
          "request": {
            "query": "limit (optional, default 50), offset (optional, default 0)"
          },
          "response": {
            "status": 200,
            "body": "{ tasks: [{ id, title, completed, created_at }], total }"
          }
        },
        {
          "method": "POST",
          "path": "/tasks",
          "request": {
            "title": "string required"
          },
          "response": {
            "status": 201,
            "body": "{ id, title, completed, created_at }"
          }
        },
        {
          "method": "PUT",
          "path": "/tasks/:id",
          "request": {
            "title": "string optional",
            "completed": "boolean optional"
          },
          "response": {
            "status": 200,
            "body": "{ id, title, completed, created_at }"
          }
        },
        {
          "method": "DELETE",
          "path": "/tasks/:id",
          "response": {
            "status": 204,
            "body": null
          }
        }
      ]
    },
    "vectorEngine": null,
    "uiContract": {
      "primary_view": "list of user's tasks",
      "primary_action": "add a new task",
      "secondary_views": [],
      "components": [
        {
          "name": "TaskList",
          "role": "displays all tasks for the current user with completion status"
        },
        {
          "name": "TaskItem",
          "role": "single task row with toggle complete and delete actions"
        },
        {
          "name": "AddTaskForm",
          "role": "input field and button to create a new task"
        }
      ]
    },
    "businessLogicContract": {
      "triggers": [
        {
          "event": "user_first_login",
          "action": "create users row from OIDC claims (sub, email)"
        }
      ],
      "rules": [
        "users can only see their own tasks",
        "users can only update or delete their own tasks",
        "task title must be non-empty on create and update"
      ],
      "side_effects": []
    },
    "fileStructure": {
      "backend": {
        "language": "node",
        "entry": "backend/src/index.ts",
        "required_files": [
          "backend/src/index.ts",
          "backend/package.json",
          "backend/Dockerfile"
        ],
        "required_dirs": [
          "backend/src",
          "backend/src/generated"
        ],
        "forbidden_paths": [
          "backend/main.py"
        ]
      },
      "frontend": {
        "framework": "react-vite",
        "required_files": [
          "frontend/src/main.tsx",
          "frontend/src/App.tsx",
          "frontend/package.json",
          "frontend/Dockerfile",
          "frontend/nginx.conf",
          "frontend/nginx.local.conf",
          "frontend/vite.config.ts"
        ],
        "required_dirs": [
          "frontend/src",
          "frontend/src/generated"
        ]
      },
      "database": {
        "engine": "postgres",
        "required_files": [
          "database/Dockerfile"
        ],
        "required_dirs": [
          "database/init"
        ]
      },
      "integration": {
        "required_files": [
          "docker-compose.yml",
          ".env.example"
        ]
      }
    },
    "tasksByScope": {
      "database": {
        "scope": "database",
        "summary": "Stores user accounts and their personal tasks with completion status.",
        "task": "Tables: users, tasks. Indexes: tasks(user_id), tasks(created_at DESC). Column-level contract: data_model.",
