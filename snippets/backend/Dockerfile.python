# ============================================================================
# Python Backend (FastAPI/Flask) - SECURE
# ============================================================================
# Runs as non-root user for defense in depth.
# Base: python:3.12-slim (minimal, security). The common FastAPI stack
# (fastapi/uvicorn/pydantic, psycopg2-binary, asyncpg) ships manylinux wheels,
# so `pip install` needs no build toolchain here. curl is REQUIRED for the
# `/health` healthcheck — used by both the local docker-compose service_healthy
# gate and the ECS Fargate container health check (see .platform-rules/
# security.md). Mirrors the node backend + frontend runtime pattern.
# ============================================================================

FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ============================================
# SECURITY: Create non-root user
# ============================================
RUN groupadd -g 1001 appgroup && \
    useradd -u 1001 -g appgroup -s /bin/bash appuser

WORKDIR /app
# Non-root user owns its workdir so the app can create runtime dirs
# (uploads, cache, …) under /app without an EACCES crash on boot.
RUN chown appuser:appgroup /app

# Install dependencies as root (before switching user). --break-system-packages
# matches the kitchen-sink install path; cached pkgs report "already satisfied".
COPY requirements.txt .
RUN pip install --break-system-packages --no-cache-dir -r requirements.txt

# Copy application code with correct ownership
COPY --chown=appuser:appgroup . .

# Switch to non-root user
USER appuser

EXPOSE 3000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "3000"]
