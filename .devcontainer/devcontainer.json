{
  "name": "Vibe Hackathon Dev Environment",

  "customizations": {
    "vscode": {
      "extensions": [
        // ✨ Auto-formatting - Makes your code look pretty automatically
        "esbenp.prettier-vscode",
        
        // 🔴 Error Lens - Shows errors right in the code (very visual!)
        "usernamehv.errorlens",
        
        // 🐳 Docker - Helps with containers
        "ms-azuretools.vscode-docker",
        
        // 📁 Better file icons
        "vscode-icons-team.vscode-icons",

        // 🤖 Claude Code — AI coding assistant (routed to Bayer myGenAssist
        //    via claude-code-router; see .devcontainer/setup-claude-router.sh)
        "Anthropic.claude-code"
      ],
      
      "settings": {
        // === AUTO-FORMAT ON SAVE (no action needed!) ===
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        
        // === VISUAL HELPERS ===
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": true,
        "editor.minimap.enabled": false,
        "editor.wordWrap": "on",
        
        // === ERROR LENS (shows errors inline) ===
        "errorLens.enabledDiagnosticLevels": ["error", "warning"],
        "errorLens.messageMaxChars": 100,
        
        // === TERMINAL ===
        "terminal.integrated.defaultProfile.linux": "bash",

        // === FILES ===
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "explorer.confirmDelete": false
      }
    }
  },

  // Optional: lets users provide the myGenAssist key before the Codespace
  // starts (shows in the "Recommended secrets" step on the create page).
  // Set the value in Codespaces Settings; leave unset to enter it in the
  // terminal via `mga-login`. This is only a UI hint — it does NOT request
  // any repo permissions, so it can't trigger a permission-authorization wall.
  "secrets": {
    "MYGENASSIST_API_KEY": {
      "description": "Bayer myGenAssist API key — powers Claude Code via claude-code-router. Set it in Codespaces Settings to auto-configure on start, or leave unset and run `mga-login` in the terminal. See docs/CODESPACE_CLAUDE_CODE_SETUP.md"
    }
  },

  // Point Claude Code at the local router from first launch (no reload needed).
  // Non-secret + Codespace-only (does NOT affect maintainers' local Claude Code).
  // The real API key lives in the CCR config, not here.
  "remoteEnv": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:3456",
    "ANTHROPIC_AUTH_TOKEN": "dummy",
    "ANTHROPIC_MODEL": "myGenAssist,claude-sonnet-5",
    "ANTHROPIC_SMALL_FAST_MODEL": "myGenAssist,claude-sonnet-4.5-azure"
  },

  // The default image bundles the git-lfs feature with autoPull=true; its
  // post-create step runs `git lfs install`, which refuses to overwrite our
  // pre-push audit hook (installed by scripts/install-hooks.sh on the first
  // start) and exits 2 — and the devcontainer CLI then SKIPS every later
  // lifecycle command, including postStartCommand, on a container REBUILD
  // (observed 2026-09-11: no deps, no build, no sysctl, no harness).
  // Redeclaring the feature with autoPull=false makes that step a no-op;
  // this repo tracks no LFS files.
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": { "autoPull": false }
  },

  "onCreateCommand": "bash .devcontainer/setup-claude-router.sh",
  // In Codespaces the harness (chat/) is also STARTED here, in the background
  // (log: /tmp/harness.log), so a restarted codespace comes back with the UI
  // on 5050 without anyone typing `npm start`. Guarded against double starts;
  // idle cost is a node process only (no validator container until a build);
  // opt out with the Codespaces secret/env HARNESS_AUTOSTART=0 or a
  // .chat/no-autostart file. Codespace detection is the /.codespaces dir, not
  // $CODESPACE_NAME — lifecycle commands don't get the terminal profile env.
  // The server is started with setsid (own session): the lifecycle runner
  // kills the hook's process group when the command returns, and a plain
  // nohup child died with it (empty /tmp/harness.log, no process).
  // /tmp/harness-hook.log records what the guard saw. "Already running" is
  // decided by asking port 5050, never by pgrep: the shell running this hook
  // has the start command in its own command line, so any process pattern
  // that matches the server also matches the hook (skipped every boot until
  // 2026-09-11).
  // The sysctl keeps same-bridge container traffic out of iptables. The default
  // Codespaces image moved to Docker 29.x (2026-09), whose bridge firewall rules
  // fail to install inside the nested kernel: containers stay "healthy" (localhost
  // works) but frontend->backend and backend->database TCP silently hang.
  // Verified fix 2026-09-10; harmless where the rules install correctly.
  "postStartCommand": "sudo sysctl -w net.bridge.bridge-nf-call-iptables=0 >/dev/null 2>&1 || true; bash .devcontainer/auto-update-template.sh; bash scripts/install-hooks.sh; bash scripts/audit/install-claude-hooks.sh; [ -f chat/package.json ] && (cd chat && npm install --no-audit --no-fund --loglevel=error && npm run build --silent) || true; echo \"autostart check: codespaces=$([ -d /.codespaces ] && echo y || echo n) optout=${HARNESS_AUTOSTART:-unset} dist=$([ -f chat/dist/index.html ] && echo y || echo n) running=$(curl -s -o /dev/null -m 2 http://localhost:5050/health && echo y || echo n)\" > /tmp/harness-hook.log; [ -d /.codespaces ] && [ \"${HARNESS_AUTOSTART:-1}\" != \"0\" ] && [ ! -f .chat/no-autostart ] && [ -f chat/dist/index.html ] && ! curl -s -o /dev/null -m 2 http://localhost:5050/health && (cd chat && SQL_VALIDATOR_WARMUP=0 setsid nohup node server/index.js > /tmp/harness.log 2>&1 < /dev/null &) && echo \"started harness\" >> /tmp/harness-hook.log || true",

  // Pre-forwarded on purpose: GitHub registers ports on its proxy only when
  // (a) they are listed here, or (b) an EDITOR client auto-detects a
  // listening process. The vibe portal starts codespaces through the API
  // with no editor attached (verified 2026-09-11: `gh codespace ports` came
  // back EMPTY after an API start with forwardPorts: []), so the harness
  // (5050) and the generated app (8080, its backend 3000) must be listed to
  // be reachable at all. A listed port can go stale after an editor-driven
  // restart (browser 404 while `gh codespace ports` still lists it) — the
  // remedy is Stop Forwarding + Add Port in the Ports tab, documented.
  "forwardPorts": [3000, 5050, 8080],

  "portsAttributes": {
    "5050": { "label": "Harness (chat UI + API)", "onAutoForward": "notify" },
    "8080": { "label": "Generated app", "onAutoForward": "notify" },
    "3000": { "label": "Generated app backend", "onAutoForward": "silent" },
    "5173": { "label": "Vite (frontend-only projects)", "onAutoForward": "notify" },
    "3456": { "label": "Claude Code Router", "onAutoForward": "silent" }
  }
}
