{
  "name": "Vibe Hackathon Dev Environment",

  "customizations": {
    "vscode": {
      "extensions": [
        // ✨ Auto-formatting - Makes your code look pretty automatically
        "esbenp.prettier-vscode",
        
        // 🔴 Error Lens - Shows errors right in the code (very visual!)
        "usernamehv.errorlens",
        
        // 🐳 Docker - Helps with containers
        "ms-azuretools.vscode-docker",
        
        // 📁 Better file icons
        "vscode-icons-team.vscode-icons",

        // 🤖 Claude Code — AI coding assistant (routed to Bayer myGenAssist
        //    via claude-code-router; see .devcontainer/setup-claude-router.sh)
        "Anthropic.claude-code"
      ],
      
      "settings": {
        // === AUTO-FORMAT ON SAVE (no action needed!) ===
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        
        // === VISUAL HELPERS ===
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": true,
        "editor.minimap.enabled": false,
        "editor.wordWrap": "on",
        
        // === ERROR LENS (shows errors inline) ===
        "errorLens.enabledDiagnosticLevels": ["error", "warning"],
        "errorLens.messageMaxChars": 100,
        
        // === TERMINAL ===
        "terminal.integrated.defaultProfile.linux": "bash",

        // === FILES ===
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "explorer.confirmDelete": false
      }
    }
  },

  // Optional: lets users provide the myGenAssist key before the Codespace
  // starts (shows in the "Recommended secrets" step on the create page).
  // Set the value in Codespaces Settings; leave unset to enter it in the
  // terminal via `mga-login`. This is only a UI hint — it does NOT request
  // any repo permissions, so it can't trigger a permission-authorization wall.
  "secrets": {
    "MYGENASSIST_API_KEY": {
      "description": "Bayer myGenAssist API key — powers Claude Code via claude-code-router. Set it in Codespaces Settings to auto-configure on start, or leave unset and run `mga-login` in the terminal. See docs/CODESPACE_CLAUDE_CODE_SETUP.md"
    }
  },

  // Point Claude Code at the local router from first launch (no reload needed).
  // Non-secret + Codespace-only (does NOT affect maintainers' local Claude Code).
  // The real API key lives in the CCR config, not here.
  "remoteEnv": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:3456",
    "ANTHROPIC_AUTH_TOKEN": "dummy",
    "ANTHROPIC_MODEL": "myGenAssist,claude-sonnet-5",
    "ANTHROPIC_SMALL_FAST_MODEL": "myGenAssist,claude-sonnet-4.5-azure"
  },

  "onCreateCommand": "bash .devcontainer/setup-claude-router.sh",
  // The sysctl keeps same-bridge container traffic out of iptables. The default
  // Codespaces image moved to Docker 29.x (2026-09), whose bridge firewall rules
  // fail to install inside the nested kernel: containers stay "healthy" (localhost
  // works) but frontend->backend and backend->database TCP silently hang.
  // Verified fix 2026-09-10; harmless where the rules install correctly.
  "postStartCommand": "sudo sysctl -w net.bridge.bridge-nf-call-iptables=0 >/dev/null 2>&1 || true; bash .devcontainer/auto-update-template.sh; bash scripts/install-hooks.sh; bash scripts/audit/install-claude-hooks.sh; [ -f chat/package.json ] && (cd chat && npm install --no-audit --no-fund --loglevel=error) || true",

  // 3000 backend · 5173 Vite dev server · 8080 frontend (nginx)
  // 5050 = chat/ harness (API + built UI), 8889 = its Vite dev client;
  // 8080/3000 = the generated app; 5173 = Vite for frontend-only projects.
  "forwardPorts": [3000, 5050, 5173, 8080, 8889],

  "portsAttributes": {
    "5050": { "label": "Harness (chat UI + API)", "onAutoForward": "notify" },
    "8889": { "label": "Harness Vite dev client" },
    "3456": { "label": "Claude Code Router", "onAutoForward": "silent" }
  }
}
