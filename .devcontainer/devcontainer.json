{
  "name": "Vibe Hackathon Dev Environment",
  
  "customizations": {
    "vscode": {
      "extensions": [
        // 🤖 AI Coding Assistant - Ask it to write code for you!
        "saoudrizwan.claude-dev",
        
        // ✨ Auto-formatting - Makes your code look pretty automatically
        "esbenp.prettier-vscode",
        
        // 🔴 Error Lens - Shows errors right in the code (very visual!)
        "usernamehv.errorlens",
        
        // 🐳 Docker - Helps with containers
        "ms-azuretools.vscode-docker",
        
        // 📁 Better file icons
        "vscode-icons-team.vscode-icons"
      ],
      
      "settings": {
        // === AUTO-FORMAT ON SAVE (no action needed!) ===
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        
        // === VISUAL HELPERS ===
        "editor.bracketPairColorization.enabled": true,
        "editor.guides.bracketPairs": true,
        "editor.minimap.enabled": false,
        "editor.wordWrap": "on",
        
        // === ERROR LENS (shows errors inline) ===
        "errorLens.enabledDiagnosticLevels": ["error", "warning"],
        "errorLens.messageMaxChars": 100,
        
        // === TERMINAL ===
        "terminal.integrated.defaultProfile.linux": "bash",
        
        // === FILES ===
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "explorer.confirmDelete": false
      }
    }
  },

  "postCreateCommand": "docker build -t chat-ui ./chat && echo '🎉 Welcome to Vibe Hackathon! Your dev environment is ready.'",

  "postStartCommand": "docker rm -f chat-ui 2>/dev/null; docker run -d --name chat-ui -p 8888:8888 -v \"$(pwd):/workspace\" -v /var/run/docker.sock:/var/run/docker.sock chat-ui && git pull --ff-only 2>/dev/null || true",

  "forwardPorts": [3000, 5050, 5173, 8080, 8888],

  "portsAttributes": {
    "8888": { "label": "Chat UI", "onAutoForward": "openBrowser" },
    "5050": { "label": "Runner API", "onAutoForward": "silent" }
  }
}
