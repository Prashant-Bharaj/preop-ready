# =============================================================================
# LOCAL DEVELOPMENT SECRETS
# =============================================================================
# 
# HOW TO USE:
# 1. Copy this file: cp env.example .env
# 2. Fill in your actual values
# 3. The .env file is gitignored (your secrets stay private!)
#
# FOR PRODUCTION:
# Don't put secrets here! Add them to GitHub instead:
# → Repo Settings → Secrets → Actions → New secret
# → Use APP_ prefix (e.g., APP_OPENAI_KEY becomes OPENAI_KEY in code)
#
# =============================================================================

# OpenAI API Key (for AI features)
OPENAI_KEY=sk-your-key-here

# Generic API credentials
API_KEY=your-api-key
API_SECRET=your-api-secret

# JWT Secret (for authentication)
JWT_SECRET=your-jwt-secret

# Custom secrets (use for anything)
SECRET_1=
SECRET_2=
SECRET_3=

# =============================================================================
# DATABASE (auto-provided in production, set for local dev)
# =============================================================================
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_NAME=myapp
DATABASE_USER=root
DATABASE_PASSWORD=password
