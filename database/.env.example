# PostgreSQL Database Configuration
# These values are used for local development with docker-compose
# In production (ECS), these are auto-injected by the platform

POSTGRES_DB=recognition
POSTGRES_USER=recognition_user
POSTGRES_PASSWORD=recognition_pass_local_dev_only

# Connection details (used by backend)
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_NAME=recognition
DATABASE_USER=recognition_user
DATABASE_PASSWORD=recognition_pass_local_dev_only
