# ============================================================================
# Database Environment Variables
# ============================================================================
# These are set automatically by the platform during deployment.
# Use this file for local development with docker-compose.
#
# Copy to .env and customize as needed.
# ============================================================================

# PostgreSQL / pgvector
POSTGRES_DB=myapp
POSTGRES_USER=myapp_user
POSTGRES_PASSWORD=localdev123

# MySQL (if using Dockerfile.mysql)
# MYSQL_DATABASE=myapp
# MYSQL_USER=myapp_user
# MYSQL_PASSWORD=localdev123
# MYSQL_ROOT_PASSWORD=localdev123

# ChromaDB (if using Dockerfile.chroma)
# No credentials needed - uses anonymous access locally

# Qdrant (if using Dockerfile.qdrant)
# No credentials needed for local development
# QDRANT__SERVICE__API_KEY=your-api-key  # Optional: enable for production
